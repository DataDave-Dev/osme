# Copy to .env. Development values only; never reuse them on a real installation.
POSTGRES_USER=osme
POSTGRES_PASSWORD=osme_dev
POSTGRES_DB=osme
# 5433 so it does not collide with a PostgreSQL already installed on the machine.
POSTGRES_PORT=5433

# Connection string the server and the tests read.
OSME_DB="Host=localhost;Port=5433;Database=osme;Username=osme;Password=osme_dev"
